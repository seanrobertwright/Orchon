{
  "about": "Rows of workspace.list, one or more for each row shape in the table of decision #25 (What hostId does Orca report for SSH and WSL workspaces?), with Windows paths in both slash directions, except a path with the long-path prefix, which Windows reads with backslashes only. They are written from that table and are not recordings: no SSH or WSL workspace was available to record.",
  "fields": {
    "shape": "the row of the table this row stands for",
    "platform": "'win32' when the answer holds for a worker on Windows only, 'any' when it holds on every platform",
    "localAndWritable": "what the local-and-writable test of #25 answers for the row",
    "row": "the row as workspace.list gives it"
  },
  "shapes": [
    {
      "shape": "local",
      "table": "On this machine"
    },
    {
      "shape": "ssh",
      "table": "On an SSH host"
    },
    {
      "shape": "wsl-share",
      "table": "WSL, project opened through the WSL share"
    },
    {
      "shape": "wsl-runtime-on-drive",
      "table": "WSL, project on a Windows drive with its runtime set to WSL"
    },
    {
      "shape": "wsl-host",
      "table": "WSL host (experimental setting, off by default)"
    },
    {
      "shape": "paired-server",
      "table": "Any paired Orca server"
    },
    {
      "shape": "group-folder-no-host",
      "table": "A folder of a project group with no host stamp"
    }
