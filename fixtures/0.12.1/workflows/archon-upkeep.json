{
  "release": "0.12.1",
  "scenario": "workflows/archon-upkeep",
  "log": [
    {
      "atMs": 4,
      "kind": "http",
      "method": "GET",
      "path": "/api/workflows/archon-upkeep?cwd=<project-path>",
      "requestBody": null,
      "startedMs": 0,
      "status": 200,
      "contentType": "application/json",
      "body": {
        "workflow": {
          "name": "archon-upkeep",
          "description": "Keep one dependency current: ground the update request against the repository\nas it exists (locked version, blast radius, breaking changes that touch real\nusage), then either stop with the reason or take the bump through the full\nreviewed delivery tail. One governed run; the assessment is the work order.\n\nUse when: a dependency or security advisory should become a reviewed,\nready-to-merge PR — \"update sharp\", \"address the undici advisory\",\n\"bump X to latest\".\nNOT for: sweeping every outdated dependency at once (one target per run),\nor deciding fork-vs-replace questions (that is a human decision the\nassessment will surface, not make).\n",
          "nodes": [
            {
              "id": "forge",
              "kind": "exec",
              "script": "forge-check",
              "runtime": "bun",
              "output_format": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "gh",
                      "forge"
                    ]
                  }
                },
                "required": [
                  "source"
                ]
              }
            },
            {
              "id": "assess",
              "depends_on": [
                "forge"
              ],
              "mutates_checkout": false,
              "output_type": "dependency-assessment",
              "model": "medium",
              "output_format": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "update",
                      "no_action"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "report": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "archon_artifact"
                        ]
                      },
                      "run_id": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string",
                        "enum": [
                          "upkeep-assessment.md"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "run_id",
                      "path"
                    ]
                  }
                },
                "required": [
                  "action",
                  "summary",
                  "report"
                ]
              },
              "kind": "agent",
              "source": {
                "kind": "command",
                "name": "assess"
              }
            },
            {
              "id": "deliver",
              "depends_on": [
                "assess"
              ],
              "when": "$assess.output.action == 'update'",
              "kind": "include",
              "include": "archon-deliver-block",
              "with": {
                "errors": "$INPUTS.errors",
                "work": "Apply the dependency update specified in $ARTIFACTS_DIR/upkeep-assessment.md. Read that file in full first — it is the verified work order, and you know nothing about this update beyond it and the repository itself. Follow its update order: use the project's own package manager, change the manifest only as the assessment directs, update the lockfile for the target dependency with it, keep churn minimal, and never downgrade anything unrelated. Fix what the bump breaks, check it with the project's own tests for what changed, and if reality contradicts the assessment (version unavailable, an unlisted peer conflict), stop honestly with green false and the contradiction in your summary rather than improvising a different version. Carry the assessment's chosen mechanism, its blast radius, and the alternative it rejected into your report — the reviewer must be able to judge that trade-off from the pull request. Original request: $INPUTS.target"
              }
            },
            {
              "id": "outcome",
              "depends_on": [
                "assess",
                "deliver"
              ],
              "trigger_rule": "none_failed_min_one_success",
              "kind": "exec",
              "script": "outcome",
              "runtime": "bun",
              "with": {
                "action": "$assess.output.action",
                "summary": "$assess.output.summary",
                "delivered": {
                  "from": "$deliver.output.ready",
                  "if_skipped": null
                },
                "delivery": {
                  "from": "$deliver.output.summary",
                  "if_skipped": null
                },
                "pr_url": {
                  "from": "$deliver.output.pr_url",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "delivered": {
                    "type": "boolean"
                  },
                  "pr_url": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "delivered",
                  "pr_url",
                  "summary"
                ]
              }
            }
          ],
          "inputs": {
            "target": {
              "default": "",
              "description": "The update to assess — a dependency name, version, or advisory. When empty, the run's trigger message is the target."
            },
            "errors": {
              "default": "auto",
              "description": "Silent-failure lens — auto, true, or false."
            }
          },
          "returns": "outcome",
          "outcome_field": "delivered"
        },
        "authored": {
          "name": "archon-upkeep",
          "description": "Keep one dependency current: ground the update request against the repository\nas it exists (locked version, blast radius, breaking changes that touch real\nusage), then either stop with the reason or take the bump through the full\nreviewed delivery tail. One governed run; the assessment is the work order.\n\nUse when: a dependency or security advisory should become a reviewed,\nready-to-merge PR — \"update sharp\", \"address the undici advisory\",\n\"bump X to latest\".\nNOT for: sweeping every outdated dependency at once (one target per run),\nor deciding fork-vs-replace questions (that is a human decision the\nassessment will surface, not make).\n",
          "inputs": {
            "target": {
              "default": "",
              "description": "The update to assess — a dependency name, version, or advisory. When empty, the run's trigger message is the target."
            },
            "errors": {
              "default": "auto",
              "description": "Silent-failure lens — auto, true, or false."
            }
          },
          "returns": "outcome",
          "outcome_field": "delivered",
          "nodes": [
            {
