                              },
                              "evidence": {
                                "type": "string",
                                "pattern": "\\S"
                              },
                              "confidence": {
                                "type": "string",
                                "enum": [
                                  "low",
                                  "medium",
                                  "high"
                                ]
                              },
                              "would_change": {
                                "type": "string",
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "choice",
                              "why",
                              "evidence",
                              "confidence",
                              "would_change"
                            ]
                          },
                          "choices": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                                },
                                "label": {
                                  "type": "string",
                                  "pattern": "\\S"
                                },
                                "does": {
                                  "type": "string",
                                  "pattern": "\\S"
                                },
                                "effect": {
                                  "type": "string",
                                  "enum": [
                                    "hold"
                                  ]
                                },
                                "ruling": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "label",
                                "does",
                                "effect",
                                "ruling"
                              ]
                            }
                          },
                          "if_unanswered": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "links": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "what",
                          "why",
                          "recommendation",
                          "choices",
                          "if_unanswered",
                          "links"
                        ]
                      }
                    },
                    "required": [
                      "state",
                      "rerun",
                      "summary",
                      "attention"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "decisions",
                  "review_url",
                  "review_prior",
                  "dev",
                  "summary"
                ]
              }
            },
            {
              "id": "review",
              "include": "archon-review-block",
              "depends_on": [
                "sweep"
              ],
              "when": "$sweep.output.review_url != '' && $INPUTS.mode == 'live'",
              "with": {
                "scope": "$sweep.output.review_url",
                "prior_report": "$sweep.output.review_prior"
              }
            },
            {
              "id": "record",
              "script": "record",
              "runtime": "bun",
              "depends_on": [
                "facts",
                "sweep",
                "review"
              ],
              "trigger_rule": "all_done",
              "with": {
                "path": "$facts.output.path",
                "items": {
                  "from": "$facts.output.items"
                },
                "settled": {
                  "from": "$facts.output.settled"
                },
                "sweep": {
                  "from": "$sweep.output",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "merged": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "summary": {
                    "type": "string"
                  },
                  "attention": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ]
                    }
                  },
                  "class": {
                    "type": "string",
                    "enum": [
                      "",
                      "pr",
                      "dev"
                    ]
                  },
                  "asked": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "evaluation": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "required": [
                  "merged",
                  "summary",
                  "attention",
                  "options",
                  "class",
                  "asked",
                  "evaluation"
                ]
              }
            },
            {
              "id": "ask",
              "depends_on": [
                "record"
              ],
              "when": "$record.output.attention != ''",
              "wait": {
                "attention": "$record.output.attention",
                "form": "select",
                "options": "$record.output.options",
                "labels": {
                  "merge": "$record.output.class"
                }
              }
            },
            {
              "id": "ruling",
              "script": "ruling",
              "runtime": "bun",
              "depends_on": [
                "record",
                "ask"
              ],
              "with": {
                "asked": {
                  "from": "$record.output.asked"
                },
                "choice": "$ask.output.decision",
                "text": "$ask.output.text"
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "merge",
                      "return",
                      "park",
                      "hold"
                    ]
                  },
                  "section": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "decision",
                  "section",
                  "summary"
                ]
              }
            }
          ]
        },
        "filename": "archon-merge-queue.yaml",
        "source": "bundled"
      }
    }
  ]
}
