                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "choice",
                              "why",
                              "evidence",
                              "confidence",
                              "would_change"
                            ]
                          },
                          "choices": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                                },
                                "label": {
                                  "type": "string",
                                  "pattern": "\\S"
                                },
                                "does": {
                                  "type": "string",
                                  "pattern": "\\S"
                                },
                                "effect": {
                                  "type": "string",
                                  "enum": [
                                    "hold"
                                  ]
                                },
                                "ruling": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "label",
                                "does",
                                "effect",
                                "ruling"
                              ]
                            }
                          },
                          "if_unanswered": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "links": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "what",
                          "why",
                          "recommendation",
                          "choices",
                          "if_unanswered",
                          "links"
                        ]
                      }
                    },
                    "required": [
                      "summary",
                      "attention"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "decisions",
                  "base",
                  "summary"
                ]
              }
            },
            {
              "id": "record",
              "script": "record",
              "runtime": "bun",
              "depends_on": [
                "facts",
                "sweep"
              ],
              "trigger_rule": "none_failed_min_one_success",
              "with": {
                "path": "$facts.output.path",
                "base_error": "$facts.output.base_error",
                "items": {
                  "from": "$facts.output.items"
                },
                "settled": {
                  "from": "$facts.output.settled"
                },
                "base": {
                  "from": "$facts.output.base"
                },
                "sweep": {
                  "from": "$sweep.output",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "merged": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "summary": {
                    "type": "string"
                  },
                  "attention": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "does": {
                          "type": "string"
                        },
                        "value": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "does",
                        "value"
                      ]
                    }
                  },
                  "recommendation": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "class": {
                    "type": "string",
                    "enum": [
                      "",
                      "pr",
                      "base"
                    ]
                  },
                  "asked": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "required": [
                  "merged",
                  "summary",
                  "attention",
                  "options",
                  "recommendation",
                  "class",
                  "asked"
                ]
              }
            },
            {
              "id": "retriage",
              "script": "retriage",
              "runtime": "bun",
              "depends_on": [
                "facts",
                "record"
              ],
              "with": {
                "items": {
                  "from": "$facts.output.items"
                },
                "settled": {
                  "from": "$facts.output.settled"
                },
                "merged": {
                  "from": "$record.output.merged"
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "retriaged": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "retriaged",
                  "summary"
                ]
              }
            },
            {
              "id": "ask",
              "depends_on": [
                "record"
              ],
              "when": "$record.output.attention != ''",
              "wait": {
                "attention": "$record.output.attention",
                "form": "select",
                "options": "$record.output.options",
                "recommendation": "$record.output.recommendation",
                "labels": {
                  "merge": "$record.output.class"
                }
              }
            },
            {
              "id": "ruling",
              "script": "ruling",
              "runtime": "bun",
              "depends_on": [
                "record",
                "ask"
              ],
              "with": {
                "asked": {
                  "from": "$record.output.asked"
                },
                "choice": {
                  "from": "$ask.output.value"
                },
                "text": "$ask.output.text"
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "merge",
                      "return",
                      "park",
                      "hold"
                    ]
                  },
                  "section": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "decision",
                  "section",
                  "summary"
                ]
              }
            }
          ]
        },
        "filename": "archon-merge-queue.yaml",
        "source": "bundled"
      }
    }
  ]
}
