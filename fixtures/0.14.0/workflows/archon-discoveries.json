{
  "release": "0.14.0",
  "scenario": "workflows/archon-discoveries",
  "log": [
    {
      "atMs": 11,
      "kind": "http",
      "method": "GET",
      "path": "/api/workflows/archon-discoveries?cwd=<project-path>",
      "requestBody": null,
      "startedMs": 0,
      "status": 200,
      "contentType": "application/json",
      "body": {
        "workflow": {
          "name": "archon-discoveries",
          "description": "Drain the discoveries finished runs recorded outside their own scope. Each pass\nclaims the oldest finished runs with undecided discovery records, and one agent\nverifies every record against the default branch, merges duplicates across runs\nand with earlier decisions, and decides each one: file an issue with a full brief,\ntrack it on the open issue that already covers it (with a marked evidence comment\nonly when it adds something), drop it with a reason, or ask a maintainer. The nodes\nafter the agent perform only the writes it declared and read them back. Each\ndrained run's state document records the refs decided for it and any question\nasked with its answer, so a record is decided once; a filed issue carries its\nkey's marker, so filing a key again recovers that issue.\n\nUse when: an operator drains discoveries by hand, or a schedule binding the\noperator installed starts it (see the SDLC pack README, \"Discoveries\"). The pack\ninstalls no binding.\nNOT for: delivering the filed work (intake triages each filed issue), or reading\none run's discoveries (its terminal report lists them).\n",
          "mutates_checkout": false,
          "nodes": [
            {
              "id": "facts",
              "kind": "exec",
              "script": "facts",
              "runtime": "bun",
              "output_format": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "decide"
                    ]
                  },
                  "base": {
                    "type": "object",
                    "properties": {
                      "branch": {
                        "type": "string"
                      },
                      "sha": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "branch",
                      "sha"
                    ]
                  }
                },
                "required": [
                  "path",
                  "base"
                ]
              }
            },
            {
              "id": "decide",
              "depends_on": [
                "facts"
              ],
              "when": "$facts.output.path == 'decide'",
              "mutates_checkout": false,
              "model": "large",
              "output_format": {
                "type": "object",
                "properties": {
                  "decisions": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "outcome": {
                              "type": "string",
                              "enum": [
                                "file"
                              ]
                            },
                            "key": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
                            },
                            "refs": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            },
                            "title": {
                              "type": "string",
                              "pattern": "\\S"
                            },
                            "body": {
                              "type": "string",
                              "pattern": "\\S"
                            },
                            "reason": {
                              "type": "string",
                              "pattern": "\\S"
                            }
                          },
                          "required": [
                            "outcome",
                            "key",
                            "refs",
                            "title",
                            "body",
                            "reason"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "outcome": {
                              "type": "string",
                              "enum": [
                                "track"
                              ]
                            },
                            "key": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
                            },
                            "refs": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            },
                            "title": {
                              "type": "string",
                              "pattern": "\\S"
                            },
                            "issue": {
                              "type": "object",
                              "properties": {
                                "repo": {
                                  "type": "object",
                                  "properties": {
                                    "host": {
                                      "type": "string"
                                    },
                                    "path": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "host",
                                    "path"
                                  ]
                                },
                                "number": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              },
                              "required": [
                                "repo",
                                "number"
                              ]
                            },
                            "comment": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "reason": {
                              "type": "string",
                              "pattern": "\\S"
                            }
                          },
                          "required": [
                            "outcome",
                            "key",
                            "refs",
                            "title",
                            "issue",
                            "comment",
                            "reason"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "outcome": {
                              "type": "string",
                              "enum": [
                                "drop"
                              ]
                            },
