                            "outcome",
                            "key",
                            "refs",
                            "title",
                            "question",
                            "recommendation"
                          ]
                        }
                      ]
                    }
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "decisions",
                  "summary"
                ]
              },
              "kind": "agent",
              "source": {
                "kind": "command",
                "name": "decide",
                "with": {
                  "base_sha": "$facts.output.base.sha",
                  "repo_host": "$INPUTS.repo_host",
                  "repo_path": "$INPUTS.repo_path"
                }
