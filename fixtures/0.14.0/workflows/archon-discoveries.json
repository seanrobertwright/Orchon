                            },
                            "refs": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            },
                            "title": {
                              "type": "string",
                              "pattern": "\\S"
                            },
                            "reason": {
                              "type": "string",
                              "pattern": "\\S"
                            }
                          },
                          "required": [
                            "outcome",
                            "key",
                            "refs",
                            "title",
                            "reason"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "outcome": {
                              "type": "string",
                              "enum": [
                                "ask"
                              ]
                            },
                            "key": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
