              "kind": "exec",
              "script": "outcome",
              "runtime": "bun",
              "with": {
                "path": "$facts.output.path",
                "decisions": {
                  "from": "$decide.output.decisions",
                  "if_skipped": null
                },
                "summary": {
                  "from": "$decide.output.summary",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "written": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "file",
                            "track"
                          ]
                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "outcome",
                        "url"
                      ]
                    }
                  },
                  "dropped": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "reason"
                      ]
                    }
                  },
                  "asked": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "question": {
                    "type": "string"
                  }
                },
                "required": [
                  "summary",
                  "written",
                  "dropped",
                  "asked",
                  "question"
                ]
              }
            },
            {
              "id": "ask",
              "depends_on": [
                "outcome"
              ],
              "when": "$outcome.output.question != ''",
              "kind": "wait",
              "wait": {
                "attention": "$outcome.output.question",
                "form": "message",
                "labels": {
                  "discoveries": "question"
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            },
            {
              "id": "answer",
              "depends_on": [
                "outcome",
                "ask"
              ],
              "kind": "exec",
              "script": "answer",
              "runtime": "bun",
              "with": {
                "keys": {
                  "from": "$outcome.output.asked"
                },
                "text": "$ask.output.text"
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "answered": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "answered"
                ]
              }
            }
          ],
          "worktree": {
            "enabled": false
          },
          "inputs": {
            "repo_host": {
              "description": "The forge host of the repository the runs worked on, such as github.com."
            },
            "repo_path": {
              "description": "The owner/name path of that repository."
            },
            "since": {
              "default": "",
              "description": "Drain only runs that finished at or after this ISO-8601 time; empty is unbounded."
            },
            "until": {
              "default": "",
              "description": "Drain only runs that finished at or before this ISO-8601 time; empty is unbounded."
            },
            "limit": {
              "default": "20",
              "description": "The most runs one pass decides, oldest first."
            }
          },
          "returns": "outcome"
        },
