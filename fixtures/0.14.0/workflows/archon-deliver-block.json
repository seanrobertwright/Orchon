                              },
                              "reply": {
                                "type": "string",
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "thread",
                              "reply"
                            ]
                          }
                        },
                        "ask": {
                          "type": "boolean"
                        },
                        "summary": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "answers",
                        "ask",
                        "summary"
                      ]
                    }
                  },
                  {
                    "id": "ci",
                    "command": "ci",
                    "model": "medium",
                    "context": "fresh",
                    "mutates_checkout": false,
                    "depends_on": [
                      "review",
                      "simplify",
                      "rereview",
                      "settle-threads"
                    ],
                    "trigger_rule": "none_failed_min_one_success",
                    "with": {
                      "pr": "$pr.output"
                    },
                    "when": "$review.output.ready == true && $simplify.output.findings == false || $review.output.ready == true && $simplify.output.findings == true && $rereview.output.ready == true",
                    "output_format": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "enum": [
                            "green",
                            "pr_caused",
                            "other"
                          ]
                        },
                        "rerun": {
                          "type": "string",
                          "enum": [
                            "none",
                            "green",
                            "red"
                          ]
                        },
                        "summary": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "state",
                        "rerun",
                        "summary"
                      ]
                    }
                  },
                  {
                    "id": "threads",
                    "script": "threads",
                    "runtime": "bun",
                    "depends_on": [
                      "pr",
                      "review",
                      "rereview",
                      "ci",
                      "settle-threads"
                    ],
                    "trigger_rule": "none_failed_min_one_success",
                    "with": {
                      "pr": "$pr.output",
                      "answers": {
                        "from": "$settle-threads.output.answers",
                        "if_skipped": null
                      }
                    },
                    "output_format": {
                      "type": "object",
                      "properties": {
                        "open": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "summary": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "open",
                        "summary"
                      ]
                    }
                  },
                  {
                    "id": "round",
                    "script": "round",
                    "runtime": "bun",
                    "depends_on": [
                      "implement",
                      "pr",
                      "review",
                      "rereview",
                      "ci",
                      "threads"
                    ],
                    "trigger_rule": "all_done",
                    "with": {
                      "previous": "$LOOP_PREV.round.output.round",
                      "prior_report": "$LOOP_PREV.round.output.prior_report",
                      "previous_pr_url": "$LOOP_PREV.round.output.pr_url",
                      "previous_contract_left": "$LOOP_PREV.round.output.contract_left",
                      "green": "$implement.output.green",
                      "red_cause": "$implement.output.red_cause",
                      "implement_summary": "$implement.output.summary",
                      "pr_url": {
                        "from": "$pr.output.url",
                        "if_skipped": null
                      },
                      "review_ready": {
                        "from": "$review.output.ready",
                        "if_skipped": null
                      },
                      "review_action": {
                        "from": "$review.output.action",
                        "if_skipped": null
                      },
                      "review_summary": {
                        "from": "$review.output.findings_summary",
                        "if_skipped": null
                      },
                      "review_contract_left": {
                        "from": "$review.output.contract_left",
                        "if_skipped": null
                      },
                      "rereview_ready": {
                        "from": "$rereview.output.ready",
                        "if_skipped": null
                      },
                      "rereview_action": {
                        "from": "$rereview.output.action",
                        "if_skipped": null
                      },
                      "rereview_summary": {
                        "from": "$rereview.output.findings_summary",
                        "if_skipped": null
                      },
                      "rereview_contract_left": {
                        "from": "$rereview.output.contract_left",
                        "if_skipped": null
                      },
                      "ci": {
                        "from": "$ci.output.state",
                        "if_skipped": null
                      },
                      "ci_summary": {
                        "from": "$ci.output.summary",
                        "if_skipped": null
                      },
                      "threads_open": {
                        "from": "$threads.output.open",
                        "if_skipped": null
                      },
                      "threads_summary": {
                        "from": "$threads.output.summary",
                        "if_skipped": null
                      },
                      "settle_ask": {
                        "from": "$settle-threads.output.ask",
                        "if_skipped": null
                      },
                      "settle_summary": {
                        "from": "$settle-threads.output.summary",
                        "if_skipped": null
                      }
                    },
                    "output_format": {
                      "type": "object",
                      "properties": {
                        "round": {
                          "type": "integer"
                        },
                        "done": {
                          "type": "boolean"
                        },
                        "ready": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "pr_url": {
                          "type": "string"
                        },
                        "prior_report": {
                          "type": "string"
                        },
                        "light_review": {
                          "type": "boolean"
                        },
                        "contract_left": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "string"
                          }
                        },
                        "summary": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "round",
                        "done",
                        "ready",
                        "reason",
                        "pr_url",
                        "prior_report",
                        "light_review",
                        "contract_left",
                        "summary"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "id": "update-pr-body",
              "command": "update-pr-body",
              "model": "medium",
              "depends_on": [
                "rounds"
              ],
              "when": "$rounds.output.pr_url != ''",
              "with": {
                "pr": "$rounds.output.pr_url",
                "contract_left": "$rounds.output.contract_left"
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "changed": {
                    "type": "boolean"
                  },
                  "summary": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "changed",
                  "summary"
                ]
              }
            },
            {
              "id": "outcome",
              "script": "outcome",
              "runtime": "bun",
              "depends_on": [
                "rounds",
                "update-pr-body"
              ],
              "trigger_rule": "none_failed_min_one_success",
              "with": {
                "rounds": {
                  "from": "$rounds.output"
                }
              }
            },
            {
              "id": "report",
              "script": "report",
              "runtime": "bun",
              "always_run": true,
              "depends_on": [
                "outcome"
              ],
              "trigger_rule": "all_done",
              "with": {
                "outcome": {
                  "from": "$outcome.output",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "ready": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "pr_url": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "ready",
                  "reason",
                  "pr_url",
                  "summary"
                ]
              }
            }
          ]
        },
        "filename": "archon-deliver-block.yaml",
        "source": "bundled"
      }
    }
  ]
}
