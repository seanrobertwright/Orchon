                  "from": "$slice.output.later",
                  "if_skipped": null
                },
                "existing": {
                  "from": "$slice.output.existing",
                  "if_skipped": null
                },
                "summary": {
                  "from": "$slice.output.summary",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "closed",
                      "slice"
                    ]
                  },
                  "item": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "kind": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
