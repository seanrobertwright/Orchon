{
  "release": "0.14.0",
  "scenario": "workflows/archon-split",
  "log": [
    {
      "atMs": 9,
      "kind": "http",
      "method": "GET",
      "path": "/api/workflows/archon-split?cwd=<project-path>",
      "requestBody": null,
      "startedMs": 0,
      "status": 200,
      "contentType": "application/json",
      "body": {
        "workflow": {
          "name": "archon-split",
          "description": "The split queue: breaks a large item into the fewest pieces that each prove\nsomething on their own, when triage judged that building it as one work item would\nnot work. Each run claims the waiting item triage routed `split` with intake's\nclaim, or the one the number input names. One agent checks triage's reason first:\nwhen one work item would work after all, it hands the item to the build queue\nwhole, with why. Otherwise it files only the current piece: a PRD's current phase,\nan epic's current increment, or every task of a bundle. Later phases are recorded\non the item, each with what the earlier work must show first, and filed by a later\nsplit. A script files each issue once and records it on the item's work item. A\nPRD is labelled archon-prd and stays open until its hypothesis has a verdict; an\nepic stays open until its increments merge; a bundle is closed with links to its\nissues. The filed issues come back through intake like any other.\n\nUse when: a trigger binding the operator installed starts it (see the SDLC pack\nREADME, \"Split queue\").\nNOT for: writing a PRD, triaging (archon-intake), or building the filed issues\n(archon-build-queue).\n",
          "mutates_checkout": false,
          "nodes": [
            {
              "id": "facts",
              "kind": "exec",
              "script": "facts",
              "runtime": "bun",
              "output_format": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "closed",
                      "slice"
                    ]
                  },
                  "item": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "repo": {
                        "type": "object",
                        "properties": {
                          "host": {
                            "type": "string"
                          },
                          "path": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "host",
                          "path"
                        ]
                      },
                      "number": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "repo",
                      "number"
                    ]
                  },
                  "url": {
                    "type": "string"
                  },
                  "filed": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "item",
                  "url",
                  "filed",
                  "reason"
                ]
              }
            },
            {
              "id": "slice",
              "depends_on": [
                "facts"
              ],
              "when": "$facts.output.path == 'slice'",
              "model": "large",
              "output_format": {
                "type": "object",
                "properties": {
                  "split": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "prd",
                              "epic",
                              "bundle"
                            ]
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "whole"
                            ]
                          },
                          "route": {
                            "type": "string",
                            "enum": [
                              "plan",
                              "deliver"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "route"
                        ]
                      }
                    ]
                  },
                  "issues": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "key": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                        },
                        "title": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "body": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "key",
                        "title",
                        "body"
                      ]
                    }
                  },
                  "later": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "title": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "signal": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "title",
                        "signal"
                      ]
                    }
                  },
                  "existing": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "number": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "why": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "number",
                        "why"
                      ]
                    }
                  },
                  "summary": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "split",
                  "issues",
                  "later",
                  "existing",
                  "summary"
                ]
              },
              "kind": "agent",
              "source": {
                "kind": "command",
                "name": "slice",
                "with": {
                  "url": "$facts.output.url",
                  "filed": {
                    "from": "$facts.output.filed"
                  },
                  "reason": "$facts.output.reason"
                }
              }
            },
            {
              "id": "publish",
              "depends_on": [
                "facts",
                "slice"
