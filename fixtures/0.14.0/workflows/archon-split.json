                        "url"
                      ]
                    }
                  },
                  "adopted": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "number": {
                          "type": "integer"
                        },
                        "url": {
                          "type": "string"
                        },
                        "why": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "number",
                        "url",
                        "why"
                      ]
                    }
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "item",
                  "kind",
                  "issues",
                  "adopted",
                  "summary"
                ]
              }
            }
          ],
          "worktree": {
            "enabled": false
          },
          "inputs": {
            "repo_host": {
              "description": "The forge host of the repository whose work items the queue splits."
            },
            "repo_path": {
              "description": "The owner/name path of that repository."
            },
            "number": {
              "default": "",
              "description": "The issue to split. Empty claims the waiting item that sorts first. A number claims that item, and refuses the run with the reason when it cannot: it has no work item, another run holds it, or it does not wait for the split queue."
            }
          },
          "returns": "publish"
        },
