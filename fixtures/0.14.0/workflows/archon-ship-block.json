{
  "release": "0.14.0",
  "scenario": "workflows/archon-ship-block",
  "log": [
    {
      "atMs": 5,
      "kind": "http",
      "method": "GET",
      "path": "/api/workflows/archon-ship-block?cwd=<project-path>",
      "requestBody": null,
      "startedMs": 0,
      "status": 200,
      "contentType": "application/json",
      "body": {
        "workflow": {
          "name": "archon-ship-block",
          "description": "Ground an issue or request against the current repository before spending on\nit, then take the least speculative path: investigate an unknown cause, plan\nan undecided shape, deliver an implementation-ready work order, or stop when\nno work remains. Actionable paths converge on the reviewed delivery tail.\nOne governed run, one artifact store, no inherited issue assumptions.\n\nThe graph of archon-ship, as a building block for a workflow that composes the\nstage and owns what follows its ending. It never pauses for a person: run\narchon-ship, which adds that pause, by hand.\n",
          "nodes": [
            {
              "id": "forge",
              "kind": "exec",
              "script": "forge-check",
              "runtime": "bun"
            },
            {
              "id": "triage",
              "depends_on": [
                "forge"
              ],
              "kind": "include",
              "include": "archon-triage-block",
              "with": {
                "target": "$INPUTS.target",
                "publish": "$INPUTS.publish"
              }
            },
            {
              "id": "inv",
              "depends_on": [
                "triage"
              ],
              "when": "$triage.output.route == 'investigate'",
              "kind": "include",
              "include": "archon-investigate",
              "with": {
                "target": "Investigate the unresolved causal question recorded in $ARTIFACTS_DIR/triage.md. Read that assessment first; its confirmed facts are context, while its unknowns are the investigation target."
              }
            },
            {
              "id": "intel",
              "depends_on": [
                "triage"
              ],
              "when": "$triage.output.route == 'plan'",
              "mutates_checkout": false,
              "model": "medium",
              "kind": "agent",
              "source": {
                "kind": "command",
                "name": "intel"
              }
            },
            {
              "id": "planned",
              "depends_on": [
                "triage",
                "intel"
              ],
              "when": "$triage.output.route == 'plan'",
              "kind": "include",
              "include": "archon-plan-block",
              "with": {
                "work": "Plan the current work item from $ARTIFACTS_DIR/triage.md. Read that assessment first, preserve its verified outcome and constraints, and decide the implementation questions it identified. Read $ARTIFACTS_DIR/intel.md too: what usage data says about this work, or why there is none.",
                "related": "$triage.output.related"
              }
            },
            {
              "id": "continues",
              "depends_on": [
                "triage"
              ],
              "kind": "exec",
              "script": "continues",
              "runtime": "bun",
              "with": {
                "caller": "$INPUTS.pull_request",
                "triage": {
                  "from": "$triage.output.pull_request"
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "pull_request": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "pull_request"
                ]
              }
            },
            {
              "id": "deliver",
              "depends_on": [
                "triage",
                "continues",
                "inv",
                "planned"
              ],
              "when": "$triage.output.route == 'deliver' || $triage.output.route == 'continue' || $triage.output.route == 'investigate' && $inv.output.verdict == 'rooted' || $triage.output.route == 'plan' && $planned.output.ready == true",
              "trigger_rule": "none_failed_min_one_success",
              "kind": "include",
              "include": "archon-deliver-block",
              "with": {
                "errors": "$INPUTS.errors",
                "part": "$INPUTS.part",
                "work": "Deliver the work prepared by this run. Read $ARTIFACTS_DIR/triage.md first. When present, plan.md or investigation.md is the detailed work order and must be read in full; triage.md records which path produced it and which source assumptions were corrected. On the direct route, triage.md itself is the verified work order. When triage.md routes this run to continue an open pull request, the work is to finish that pull request.",
                "pull_request": "$continues.output.pull_request",
                "branch": "$INPUTS.branch"
              }
            },
            {
              "id": "outcome",
              "depends_on": [
                "triage",
                "deliver"
              ],
              "trigger_rule": "none_failed_min_one_success",
              "kind": "exec",
              "script": "outcome",
              "runtime": "bun",
              "with": {
                "route": "$triage.output.route",
                "contract": "$triage.output.contract",
                "blocked_reason": "$triage.output.blocked_reason",
                "summary": "$triage.output.summary",
                "inv_verdict": {
                  "from": "$inv.output.verdict",
                  "if_skipped": null
                },
                "inv_summary": {
                  "from": "$inv.output.summary",
                  "if_skipped": null
                },
                "plan_summary": {
                  "from": "$planned.output.summary",
                  "if_skipped": null
                },
                "open_questions": {
                  "from": "$planned.output.open_questions",
                  "if_skipped": null
                },
                "delivered": {
                  "from": "$deliver.output.ready",
                  "if_skipped": null
                },
                "delivery": {
                  "from": "$deliver.output.summary",
                  "if_skipped": null
                },
                "delivery_reason": {
                  "from": "$deliver.output.reason",
                  "if_skipped": null
                },
                "pr_url": {
                  "from": "$deliver.output.pr_url",
                  "if_skipped": null
                }
              }
            },
            {
              "id": "report",
              "depends_on": [
                "outcome"
              ],
              "trigger_rule": "all_done",
              "always_run": true,
              "kind": "exec",
              "script": "report",
              "runtime": "bun",
              "with": {
                "outcome": {
                  "from": "$outcome.output",
                  "if_skipped": null
                }
              },
              "output_format": {
                "type": "object",
                "properties": {
                  "delivered": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "pr_url": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "delivered",
                  "reason",
                  "pr_url",
                  "summary"
                ]
              }
            }
          ],
          "inputs": {
            "target": {
              "default": "",
              "description": "What to take through the pipeline — an issue, document, plan, report, or free-form request. When empty, the run's trigger message is the target."
            },
            "errors": {
              "default": "auto",
              "description": "Silent-failure lens — auto, true, or false."
            },
            "part": {
              "default": "",
              "description": "The part of an approved multi-part plan this run delivers, forwarded unchanged to delivery's reviews. archon-review's `part` input owns its shape. Empty delivers the whole contract."
            },
            "publish": {
              "default": "false",
              "description": "Let triage write its derived labels to the tracker item — true or false. Off by default. Forwarded unchanged to triage; a scheduled ship run is the only place an unattended intake can turn it on."
            },
            "pull_request": {
              "default": "",
              "description": "The number of an open pull request this run continues, as the caller resolved it; `none` when the caller decided the run continues none; empty or `null` when it names none and leaves it to triage. Delivery finishes a named one whichever route triage takes; triage naming a different one, or naming one after `none`, refuses the run."
            },
            "branch": {
              "default": "",
              "description": "The branch a new pull request opens from, as the caller resolved it, forwarded unchanged to delivery. When an open pull request already has that head, the push updates it instead of opening another. Empty opens it from the checkout's branch."
            }
          },
          "returns": "report",
          "outcome_field": "delivered"
        },
