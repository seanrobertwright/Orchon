{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["orca", "orca-host", "orca-frame", "orca-services"],
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "removeComments": false,
    "newLine": "lf",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["editors/**/*.ts"],
  "exclude": [
    "editors/**/*.test.ts",
    "editors/**/*.d.ts",
    "editors/builder/archon/fixtures/**",
    "editors/builder/archon/validation/test-helpers.ts"
  ]
}
