{
  "extends": "./.orca/types/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./.orca/types", "./node_modules/@types"],
    "types": [
      "orca",
      "orca-host",
      "orca-frame",
      "orca-worker",
      "orca-services",
      "orca-testing",
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", ".orca", ".lril"]
}
